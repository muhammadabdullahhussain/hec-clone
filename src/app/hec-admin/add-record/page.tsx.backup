"use client";
import { useState } from "react";
import Swal from "sweetalert2";

interface DegreeEntry {
    id: number;
    degree_title: string;
    university: string;
    enrollment_no: string;
    date_of_issuance: string;
    attested_by: string;
    photo: File | null;
    pdf: File | null;
}

export default function AddRecordPage() {
    const [loading, setLoading] = useState(false);

    // Student-level fields
    const [studentData, setStudentData] = useState({
        application_id: "",
        name: "",
        father_name: "",
        date_of_birth: "",
        cnic: "",
        reference_number: "",
    });

    // Dynamic degrees list — each has its own full set of fields
    const [degrees, setDegrees] = useState<DegreeEntry[]>([
        {
            id: 1,
            degree_title: "",
            university: "",
            enrollment_no: "",
            date_of_issuance: "",
            attested_by: "Muhammad Sulaiman",
            photo: null,
            pdf: null,
        },
    ]);

    const addDegree = () => {
        setDegrees([
            ...degrees,
            {
                id: Date.now(),
                degree_title: "",
                university: "",
                enrollment_no: "",
                date_of_issuance: "",
                attested_by: "Muhammad Sulaiman",
                photo: null,
                pdf: null,
            },
        ]);
    };

    const removeDegree = (id: number) => {
        if (degrees.length > 1) {
            setDegrees(degrees.filter((d) => d.id !== id));
        }
    };

    const updateDegree = (id: number, field: keyof DegreeEntry, value: any) => {
        setDegrees(degrees.map((d) => (d.id === id ? { ...d, [field]: value } : d)));
    };

    const handleStudentChange = (field: keyof typeof studentData, value: string) => {
        setStudentData({ ...studentData, [field]: value });
    };

    const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
        e.preventDefault();
        setLoading(true);

        let successCount = 0;
        let lastError = "";

        try {
            for (let i = 0; i < degrees.length; i++) {
                const deg = degrees[i];
                const formData = new FormData();

                // Student fields
                formData.append("cnic", studentData.cnic);
                formData.append("reference_number", studentData.reference_number);
                // For subsequent degrees, append suffix to keep application_id unique
                const appId = i === 0 ? studentData.application_id : `${studentData.application_id}-${i + 1}`;
                formData.append("application_id", appId);
                formData.append("name", studentData.name);
                formData.append("name_on_degree", studentData.name);
                formData.append("father_name", studentData.father_name);
                formData.append("date_of_birth", studentData.date_of_birth);

                // Degree-specific fields
                formData.append("degree_title", deg.degree_title);
                formData.append("university", deg.university);
                formData.append("enrollment_no", deg.enrollment_no);
                formData.append("date_of_issuance", deg.date_of_issuance);
                formData.append("attested_by", deg.attested_by);

                if (deg.photo) formData.append("photo", deg.photo);
                if (deg.pdf) formData.append("pdf", deg.pdf);

                const res = await fetch("/api/hec-records", {
                    method: "POST",
                    body: formData,
                });

                const data = await res.json();
                if (data.success) {
                    successCount++;
                } else {
                    lastError = data.message;
                }
            }

            if (successCount > 0) {
                Swal.fire({
                    icon: "success",
                    title: "Saved!",
                    text: `Successfully added ${successCount} degree record(s).`,
                    confirmButtonColor: "#1bb55e",
                }).then(() => {
                    window.location.href = "/hec-admin/records";
                });
            } else {
                Swal.fire("Error", lastError || "Failed to add records", "error");
            }
        } catch (error) {
            Swal.fire("Error", "Server error occurred", "error");
        } finally {
            setLoading(false);
        }
    };

    const inputClass =
        "w-full border border-gray-300 p-2.5 rounded-lg text-sm bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-[#009049] outline-none";
    const labelClass = "block text-sm font-semibold text-gray-700 mb-1";
    const hintGreen = "text-xs text-emerald-600 font-medium ml-1.5";
    const hintGray = "text-xs text-gray-400 font-normal ml-1.5";

    return (
        <div className="p-4 md:p-8 max-w-6xl mx-auto">
            <h1 className="text-2xl font-bold text-gray-800 mb-6">Add New HEC Attestation Record(s)</h1>

            <form onSubmit={handleSubmit} className="bg-white p-6 rounded-lg shadow-md flex flex-col gap-6">

                {/* ── STUDENT INFORMATION ── */}
                <div>
                    <h2 className="text-xl font-bold text-gray-700 mb-4 border-b pb-2">Student Information</h2>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">

                        {/* 1. Application ID */}
                        <div>
                            <label className={labelClass}>
                                Application ID (Base) *
                                <span className={hintGray}>(System Tracking ID)</span>
                            </label>
                            <input
                                type="text"
                                required
                                className={inputClass}
                                placeholder="e.g. 5076464"
                                value={studentData.application_id}
                                onChange={(e) => handleStudentChange("application_id", e.target.value)}
                            />
                        </div>

                        {/* 2. Student Full Name */}
                        <div>
                            <label className={labelClass}>
                                Student Full Name *
                                <span className={hintGreen}>(Prints in Middle Box)</span>
                            </label>
                            <input
                                type="text"
                                required
                                className={inputClass}
                                placeholder="e.g. Mubara Naz"
                                value={studentData.name}
                                onChange={(e) => handleStudentChange("name", e.target.value)}
                            />
                        </div>

                        {/* 3. Father Name */}
                        <div>
                            <label className={labelClass}>
                                Father Name
                                <span className={hintGray}>(Prints in Middle Box)</span>
                            </label>
                            <input
                                type="text"
                                className={inputClass}
                                placeholder="e.g. Saeed Ahmed"
                                value={studentData.father_name}
                                onChange={(e) => handleStudentChange("father_name", e.target.value)}
                            />
                        </div>

                        {/* 4. Date of Birth */}
                        <div>
                            <label className={labelClass}>
                                Date of Birth
                                <span className={hintGray}>(Middle Box)</span>
                            </label>
                            <input
                                type="text"
                                className={inputClass}
                                placeholder="e.g. 1998-11-13"
                                value={studentData.date_of_birth}
                                onChange={(e) => handleStudentChange("date_of_birth", e.target.value)}
                            />
                        </div>

                        {/* 5. CNIC */}
                        <div>
                            <label className={labelClass}>
                                CNIC / Passport Number *
                                <span className={hintGray}>(Prints in Middle Box)</span>
                            </label>
                            <input
                                type="text"
                                required
                                className={inputClass}
                                placeholder="e.g. 3540139675680"
                                value={studentData.cnic}
                                onChange={(e) => handleStudentChange("cnic", e.target.value)}
                            />
                        </div>

                        {/* 6. Reference Number */}
                        <div>
                            <label className={labelClass}>
                                Reference Number *
                                <span className={hintGray}>(Prints at Top)</span>
                            </label>
                            <input
                                type="text"
                                required
                                className={inputClass}
                                placeholder="e.g. HEC/A&A/DAS/2026/5076464"
                                value={studentData.reference_number}
                                onChange={(e) => handleStudentChange("reference_number", e.target.value)}
                            />
                        </div>

                    </div>
                </div>

                {/* ── DEGREE INFORMATION (Dynamic) ── */}
                <div>
                    <div className="flex justify-between items-center border-b pb-2 mb-4">
                        <h2 className="text-xl font-bold text-gray-700">Degree Information</h2>
                        <button
                            type="button"
                            onClick={addDegree}
                            className="bg-blue-600 text-white px-3 py-1.5 rounded text-sm font-semibold hover:bg-blue-700 transition"
                        >
                            + Add Another Degree
                        </button>
                    </div>

                    <div className="space-y-6">
                        {degrees.map((deg, index) => (
                            <div key={deg.id} className="bg-gray-50 border rounded-lg p-5 relative">
                                {/* Remove button */}
                                {degrees.length > 1 && (
                                    <button
                                        type="button"
                                        onClick={() => removeDegree(deg.id)}
                                        className="absolute top-3 right-3 text-red-500 hover:text-red-700 font-bold text-sm"
                                    >
                                        ✕ Remove
                                    </button>
                                )}
                                <h3 className="font-bold text-gray-600 mb-4 text-base">Degree #{index + 1}</h3>

                                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    {/* Degree Title */}
                                    <div className="sm:col-span-2">
                                        <label className={labelClass}>
                                            Degree Title *
                                            <span className={hintGreen}>(Prints at Bottom Line)</span>
                                        </label>
                                        <input
                                            type="text"
                                            required
                                            className={inputClass}
                                            placeholder="e.g. Bachelor of Science in Chemistry"
                                            value={deg.degree_title}
                                            onChange={(e) => updateDegree(deg.id, "degree_title", e.target.value)}
                                        />
                                    </div>

                                    {/* University */}
                                    <div className="sm:col-span-2">
                                        <label className={labelClass}>
                                            University Name *
                                            <span className={hintGreen}>(Prints at Bottom Line)</span>
                                        </label>
                                        <input
                                            type="text"
                                            required
                                            className={inputClass}
                                            placeholder="e.g. University of Education, Lahore"
                                            value={deg.university}
                                            onChange={(e) => updateDegree(deg.id, "university", e.target.value)}
                                        />
                                    </div>

                                    {/* Enrollment / Roll No */}
                                    <div>
                                        <label className={labelClass}>
                                            Enrollment / Roll No
                                            <span className={hintGreen}>(Prints at Bottom Line)</span>
                                        </label>
                                        <input
                                            type="text"
                                            className={inputClass}
                                            placeholder="e.g. 23-UE-12367"
                                            value={deg.enrollment_no}
                                            onChange={(e) => updateDegree(deg.id, "enrollment_no", e.target.value)}
                                        />
                                    </div>

                                    {/* Date of Issuance */}
                                    <div>
                                        <label className={labelClass}>
                                            Date of Issuance
                                            <span className={hintGray}>(Middle Box)</span>
                                        </label>
                                        <input
                                            type="text"
                                            className={inputClass}
                                            placeholder="e.g. 2026-07-16"
                                            value={deg.date_of_issuance}
                                            onChange={(e) => updateDegree(deg.id, "date_of_issuance", e.target.value)}
                                        />
                                    </div>

                                    {/* Attested By */}
                                    <div className="sm:col-span-2">
                                        <label className={labelClass}>
                                            Attested By *
                                            <span className={hintGray}>(Officer Name)</span>
                                        </label>
                                        <input
                                            type="text"
                                            required
                                            className={inputClass}
                                            value={deg.attested_by}
                                            onChange={(e) => updateDegree(deg.id, "attested_by", e.target.value)}
                                        />
                                    </div>

                                    {/* Student Photo */}
                                    <div>
                                        <label className="block text-sm font-semibold text-gray-600 mb-1">
                                            Student Photo (Optional)
                                        </label>
                                        <input
                                            type="file"
                                            accept="image/*"
                                            className="w-full border p-2 rounded bg-white text-sm"
                                            onChange={(e) => updateDegree(deg.id, "photo", e.target.files?.[0] ?? null)}
                                        />
                                    </div>

                                    {/* Degree PDF */}
                                    <div>
                                        <label className="block text-sm font-semibold text-gray-600 mb-1">
                                            Degree PDF (Watermark + QR will be added)
                                        </label>
                                        <input
                                            type="file"
                                            accept="application/pdf"
                                            className="w-full border p-2 rounded bg-white text-sm"
                                            onChange={(e) => updateDegree(deg.id, "pdf", e.target.files?.[0] ?? null)}
                                        />
                                    </div>

                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                {/* ── SUBMIT ── */}
                <div className="flex gap-4 border-t pt-4">
                    <button
                        type="submit"
                        disabled={loading}
                        className="bg-green-700 text-white px-6 py-2 rounded font-semibold hover:bg-green-800 transition"
                    >
                        {loading ? "Processing & Saving..." : "Save Record(s)"}
                    </button>
                    <a
                        href="/hec-admin"
                        className="px-6 py-2 border rounded font-semibold hover:bg-gray-100 transition"
                    >
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    );
}
