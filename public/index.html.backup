.km-schedule-detailsbox [type=radio]:checked + strong,
.km-schedule-detailsbox [type=radio]:not(:checked) + strong {
  position: relative;
  padding-left: 27px;
  cursor: pointer;
  line-height: 17px;
  display: inline-block;
  color: #666;
  font-weight: 500;
}
.km-schedule-detailsbox [type=radio]:checked + strong:before,
.km-schedule-detailsbox [type=radio]:not(:checked) + strong:before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 18px;
  height: 18px;
  border: 1px solid #ddd;
  border-radius: 100%;
  background: #fff;
}
.km-schedule-detailsbox [type=radio]:checked + strong:after,
.km-schedule-detailsbox [type=radio]:not(:checked) + strong:after {
  content: "";
  width: 9px;
  height: 8px;
  background: #3e3c76;
  position: absolute;
  top: 4px;
  left: 5px;
  border-radius: 100%;
  transition: all 0.2s ease;
}
.km-schedule-detailsbox [type=radio]:not(:checked) + strong:after {
  opacity: 0;
  -ms-transform: scale(0);
      transform: scale(0);
}
.km-schedule-detailsbox [type=radio]:checked + strong:after {
  opacity: 1;
  -ms-transform: scale(1);
      transform: scale(1);
}
