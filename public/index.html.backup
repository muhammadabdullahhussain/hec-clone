  .mat-form-field-appearance-outline:not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-outline-start,
  .mat-form-field-appearance-outline:not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-outline-end {
    border-color: rgba(0, 0, 0, 0.65) !important;
    border-width: 1px !important;
  }
  .mat-form-field-appearance-outline:not(.mat-form-field-should-float):not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-outline-gap {
    border-color: rgba(0, 0, 0, 0.65) !important;
    border-width: 1px !important;
  }
  /* CRITICAL: When field should float (text typed or focused), top border of gap MUST be transparent to create the notch! */
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-outline-thick .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-thick .mat-form-field-outline-gap {
    border-top: none !important;
    border-top-color: transparent !important;
    border-top-width: 0 !important;
  }

  /* Gap min-width to ensure the floating label fits cleanly into the notch */
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-outline-gap {
    min-width: 125px !important;
  }
  .mat-form-field-appearance-outline:first-of-type.mat-form-field-should-float .mat-form-field-outline-gap {
    min-width: 145px !important;
  }

  /* 2. Floating Label Position (Exact live site notch alignment) */
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-label,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-label {
    transform: translateY(-1.7em) scale(0.75) !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    z-index: 3 !important;
  }

  .mat-form-field-appearance-outline:not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-label,
  .mat-form-field-appearance-outline:not(.mat-focused):not(.mat-form-field-invalid) mat-label {
    color: rgba(0, 0, 0, 0.6) !important;
    font-size: 13px !important;
    font-weight: 500 !important;
  }
  .mat-form-field-appearance-outline.mat-form-field-should-float:not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-label {
    color: rgba(0, 0, 0, 0.6) !important;
  }
  .mat-form-field-appearance-outline:not(.mat-focused):not(.mat-form-field-invalid) .mat-placeholder-required {
    color: rgba(0, 0, 0, 0.6) !important;
  }

  /* 3. Focused State (Crisp Green Outline) */
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline {
    opacity: 0 !important;
  }
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-thick {
    color: rgb(27, 181, 94) !important;
    opacity: 1 !important;
    display: flex !important;
  }
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-thick .mat-form-field-outline-start,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-thick .mat-form-field-outline-end {
    border-color: rgb(27, 181, 94) !important;
    border-width: 2px !important;
  }
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-thick .mat-form-field-outline-gap {
    border-color: rgb(27, 181, 94) !important;
    border-width: 2px !important;
    border-top: none !important;
    border-top-color: transparent !important;
    border-top-width: 0 !important;
  }
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-label,
  .mat-form-field-appearance-outline.mat-focused mat-label {
    color: rgb(0, 144, 73) !important;
    font-weight: 600 !important;
  }

  /* 4. Error / Invalid State (Crisp Red Outline only when empty/unfloated) */
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float):not(.mat-focused) .mat-form-field-outline {
    color: rgb(255, 35, 70) !important;
    opacity: 1 !important;
  }
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float):not(.mat-focused) .mat-form-field-outline-start,
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float):not(.mat-focused) .mat-form-field-outline-end,
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float):not(.mat-focused) .mat-form-field-outline-gap {
    border-color: rgb(255, 35, 70) !important;
    border-width: 1px !important;
  }
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float) .mat-form-field-label,
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float) mat-label,
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float) .mat-placeholder-required {
    color: rgb(244, 67, 54) !important;
  }
  .mat-form-field-invalid .mat-error,
  .mat-form-field-appearance-outline.mat-form-field-invalid:not(.mat-form-field-should-float) .mat-error {
    color: rgb(244, 67, 54) !important;
    font-size: 8.16px !important;
    font-weight: 500 !important;
    font-family: 'Montserrat', sans-serif !important;
    margin-top: 2px !important;
    display: block !important;
  }

  /* 4. Hints */
  .mat-form-field .mat-hint,
  .mat-form-field-appearance-outline .mat-hint,
  .mat-hint {
    color: #6b7c89 !important;
    font-weight: 500 !important;
    font-size: 11px !important;
    line-height: 1.4 !important;
    font-family: 'Montserrat', sans-serif !important;
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }
  .mat-form-field-hint-wrapper {
    display: flex !important;
    opacity: 1 !important;
  }
</style></head>

