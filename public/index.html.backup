  margin-top: 5px;
  line-height: 34px;
  max-height: 34px;
}
.selection-card .hover-content .click-box span {
  display: inline-block;
  max-height: 34px;
  line-height: 34px;
}
.selection-card .hover-content .click-box span img {
  width: 34px;
}
