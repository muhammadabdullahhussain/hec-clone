    background: rgba(215, 17, 73, 1);

    -webkit-animation: none;
    animation: none;
  }*/
.notif-btn img {
  border-radius: 100%;
  transition: all 0.5s ease;
  animation: pulse 1.2s linear infinite;
  position: relative;
}
/* Animations */
@keyframes pulse {
  0% {
    transform: scale(1, 1);
  }
  50% {
    transform: scale(1.1, 1.1);
  }
  100% {
    transform: scale(1, 1);
  }
}
