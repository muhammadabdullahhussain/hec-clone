                desDegreeId: element.id,
                letterId: element.letterId,
                university: element.university
            });
        }
        if (element.thirdLetterIssued) {
            degreesList.push({
                value: 2,
                isProvisional: element.isProvisional,
                isFinal: 2,
                label: element.exactDegreeName + ' (Third Final letter)',
                degreeTitle: element.exactDegreeName,
                desDegreeId: element.id,
                letterId: element.letterId,
