/* harmony default export */ __webpack_exports__["default"] = ("<div *ngIf=\"loader\" id=\"loaderinner\">\n  <div class=\"km-innerloader\">\n    <img src=\"./assets/media/logos/logo-2.png\" alt=\"\" />\n    <div id=\"loaders\"></div>\n  </div>\n</div>\n\n<div class=\"contact-edit-form fembassydetails hec-public-screen\">\n  <div class=\"row justify-content-center\">\n    <div class=\"col-12 col-xl-11\">\n\n      <header class=\"hec-public-header\">\n        <h1 class=\"hec-public-title\">Degree attestation verification</h1>\n        <p class=\"hec-public-lead\">\n          Enter your CNIC or passport number and HEC reference number, then complete the verification step to view your application.\n        </p>\n      </header>\n\n      <form #foreignEmbassyForm=\"ngForm\" class=\"hec-public-form\">\n\n        <section class=\"hec-panel hec-panel--search\" aria-labelledby=\"hec-search-heading\">\n          <div class=\"hec-panel-head\">\n            <h2 id=\"hec-search-heading\" class=\"hec-panel-title\">Search</h2>\n          </div>\n          <div class=\"hec-panel-body\">\n            <div class=\"row hec-form-grid\">\n              <div class=\"col-md-6 col-lg-5 custom-feild-wrapper m--margin-bottom-20-mobile\">\n                <hec-input name=\"cnic\" type=\"text\" copyAllowed=\"true\" (keydown.enter)=\"search()\" [maxlength]=\"13\"\n                  [minlength]=\"1\" required=\"true\" hint=\"CNIC or passport number without dashes\"\n                  placeholder=\"CNIC / Passport number\">\n                </hec-input>\n              </div>\n              <div class=\"col-md-6 col-lg-5 custom-feild-wrapper m--margin-bottom-20-mobile\">\n                <hec-input name=\"referenceNo\" copyAllowed=\"true\" (keydown.enter)=\"search()\" type=\"text\"\n                  hint=\"As printed on your HEC application or correspondence\" required=\"true\"\n                  placeholder=\"Reference number\" displayName=\"Reference number\" [maxlength]=\"30\" [minlength]=\"17\">\n                </hec-input>\n              </div>\n            </div>\n\n            <div class=\"hec-captcha-block\">\n              <span class=\"hec-captcha-label\">Verification</span>\n              <re-captcha name="captchaControl" siteKey="6LcidOMZAAAAAPvG8m9OP9cjgmzRlkKtDMDBNGIo"></re-captcha>\n            </div>\n\n            <div class=\"hec-toolbar\">\n              <div class=\"hec-toolbar-primary\">\n                <button type=\"button\" class=\"hec-btn hec-btn--primary\" [disabled]=\"!captchaFilled\"\n                  (click)=\"search()\">\n                  Search\n                </button>\n              </div>\n              <div class=\"hec-toolbar-secondary\">\n                <button type=\"button\" class=\"hec-btn hec-btn--reset\" (click)=\"Reset()\">Reset</button>\n                <button type=\"button\" class=\"hec-btn hec-btn--close\" (click)=\"cancel()\">Close</button>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <section *ngIf=\"degreeList.length > 0\" class=\"hec-panel hec-panel--results\" aria-labelledby=\"hec-results-heading\">\n          <div class=\"hec-panel-head hec-panel-head--split\">\n            <h2 id=\"hec-results-heading\" class=\"hec-panel-title\">Application details</h2>\n            <span class=\"hec-count-pill\">{{ degreeList.length }} result<span *ngIf=\"degreeList.length !== 1\">s</span></span>\n          </div>\n          <div class=\"tablewrap foreign-embassy-wrap hec-results-wrap\">\n            <div class=\"admin-dashboard-wrapper\">\n              <div class=\"critical-wrapper\">\n                <div class=\"row\">\n                  <div class=\"col-md-6 col-lg-6\" *ngFor=\"let application of degreeList; let i = index\">\n                    <article class=\"card degree-card hec-result-card mt-2\">\n                      <div class=\"degree-head hec-result-card-head\">\n                        <h5>Attestation record</h5>\n                      </div>\n                      <div class=\"task-detial-wrapper\">\n                        <dl class=\"hec-detail-list\">\n                          <div class=\"hec-detail-item\">\n                            <dt>Application ID</dt>\n                            <dd>{{ application?.dasApplicationId }}</dd>\n                          </div>\n                          <div class=\"hec-detail-item\">\n                            <dt>CNIC / Passport</dt>\n                            <dd>{{ application?.userPrincipalName }}</dd>\n                          </div>\n                          <div class=\"hec-detail-item hec-detail-item--full\">\n                            <dt>Reference number</dt>\n                            <dd>{{ application?.applicationReference }}</dd>\n                          </div>\n                          <div class=\"hec-detail-item\">\n                            <dt>Degree title</dt>\n                            <dd>{{ application?.degreeName }}</dd>\n                          </div>\n                          <div class=\"hec-detail-item hec-detail-item--full\">\n                            <dt>Name on degree</dt>\n                            <dd>{{ application?.nameOnDegree }}</dd>\n                          </div>\n                          <div class=\"hec-detail-item hec-detail-item--full\">\n                            <dt>University</dt>\n                            <dd>{{ application?.universityNameOnDegree }}</dd>\n                          </div>\n                          <div class=\"hec-detail-item\">\n                            <dt>Attested by</dt>\n                            <dd>{{ application?.attestationBy }}</dd>\n                          </div>\n                        </dl>\n                      </div>\n                      <div class=\"btnsrowkm\">\n                        <button type=\"button\" class=\"mat-raised-button mat-button-base mat-primary\"\n                          (click)=\"printApplicationForm(application); $event.stopPropagation()\">\n                          <img src=\"./assets/media/icons/printer.png\" alt=\"\" />Print details\n                        </button>\n                      </div>\n                    </article>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n      </form>\n    </div>\n  </div>\n</div>\n");

