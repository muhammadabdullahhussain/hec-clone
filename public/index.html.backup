.slidebox .error-msg {
  font-size: 10px;
  color: red;
}
.slidebox span.requiredValue {
  position: absolute;
  top: -29px;
  right: -10px;
}
.slidebox .switch {
  position: relative;
  display: inline-block;
  width: 55px;
  height: 22px;
  margin: 0;
}
.slidebox .switch input {
  opacity: 0;
  width: 0;
  height: 0;
}
.slidebox .switch input:checked + .slider {
  background-color: #004229;
}
.slidebox .switch input:checked + .slider::before {
  -ms-transform: translateX(32px);
  transform: translateX(32px);
}
.slidebox .switch input:focus + .slider {
  box-shadow: 0 0 1px #018451;
}
.slidebox .switch .slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #018451;
  transition: 0.4s;
  border-radius: 34px;
}
.slidebox .switch .slider:before {
  position: absolute;
  content: "";
  height: 15px;
  width: 15px;
  left: 4px;
  bottom: 3.5px;
  background-color: white;
  transition: 0.4s;
  border-radius: 50%;
}
