  z-index: 1000;
}
[_nghost-vlh-c1]   .kt-splash-screen[_ngcontent-vlh-c1]   img[_ngcontent-vlh-c1] {
  margin-left: calc(100vw - 100%);
  width: 90px;
  margin-bottom: 30px;
}
[_nghost-vlh-c1]   .kt-splash-screen[_ngcontent-vlh-c1]   span[_ngcontent-vlh-c1] {
  margin-left: calc(100vw - 100%);
  margin-bottom: 30px;
}
[_nghost-vlh-c1]   .kt-splash-screen[_ngcontent-vlh-c1]     [role=progressbar] {
  margin-left: calc(100vw - 100%);
}
