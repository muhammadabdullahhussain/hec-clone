  font-family: "das";
  src: url('/assets/fonts/das.ttf?vay0ub') format("truetype"), url('/assets/fonts/das.woff?vay0ub') format("woff"), url('/assets/fonts/das.svg?vay0ub#das') format("svg");
  font-weight: normal;
  font-style: normal;
  font-display: block;
}
[class^=das-], [class*=" das-"] {
  /* use !important to prevent issues with browser extensions that change fonts */
  font-family: "das" !important;
  speak: none;
  font-style: normal;
  font-weight: normal;
  font-variant: normal;
  text-transform: none;
  line-height: 1;
  /* Better Font Rendering =========== */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
