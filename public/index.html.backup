<!-- PREVIOUS_BACKUP_START: hec-perfect-material-styles
<style id="hec-perfect-material-styles">
  /* Global Typography */
  body, button, input, select, textarea, .hec-public-title, .hec-public-lead, .hec-panel-title, .mat-form-field {
    font-family: 'Montserrat', sans-serif !important;
  }
  .hec-panel {
    background: #ffffff !important;
    border: 1px solid #ebedf2 !important;
    border-radius: 4px !important;
    box-shadow: none !important;
  }
  .hec-panel-head {
    background: #ffffff !important;
    border-bottom: 1px solid #ebedf2 !important;
    padding: 1rem 1.25rem !important;
  }
  .hec-panel-title {
    font-size: 1rem !important;
    font-weight: 600 !important;
    color: #3f4b57 !important;
  }

  /* Form Field Geometry */
  .mat-form-field-appearance-outline .mat-form-field-wrapper {
    margin: 0.25em 0 1.25em 0 !important;
    padding-bottom: 0 !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-flex {
    padding: 0 0.75em 0 0.75em !important;
    margin-top: -0.25em !important;
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    min-height: 52px !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-infix {
    padding: 0.85em 0 0.85em 0 !important;
    border-top: 0.84375em solid transparent !important;
    position: relative !important;
    flex: auto !important;
    min-width: 0 !important;
    width: 180px !important;
  }
  .mat-input-element {
    font-family: 'Montserrat', sans-serif !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    color: #3f4b57 !important;
    width: 100% !important;
    border: none !important;
    outline: none !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 1.5 !important;
  }
  .mat-form-field-hide-placeholder .mat-input-element::placeholder {
    color: transparent !important;
    -webkit-text-fill-color: transparent !important;
  }
  .mat-form-field:not(.mat-form-field-hide-placeholder) .mat-input-element::placeholder {
    color: #a0a5ba !important;
    -webkit-text-fill-color: #a0a5ba !important;
    font-size: 13px !important;
    font-weight: 400 !important;
  }

  /* Outlines */
  .mat-form-field-appearance-outline .mat-form-field-outline {
    display: flex !important;
    position: absolute !important;
    top: 0.25em !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    pointer-events: none !important;
    color: #ebedf2 !important;
    border-radius: 4px !important;
    transition: color 0.2s ease !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-outline-start {
    border: 1px solid currentColor !important;
    border-right-style: none !important;
    border-radius: 4px 0 0 4px !important;
    width: 5px !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-outline-gap {
    border: 1px solid currentColor !important;
    border-left-style: none !important;
    border-right-style: none !important;
    border-top-style: solid !important;
    transition: border-top-color 0.2s ease, width 0.2s ease !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-outline-end {
    border: 1px solid currentColor !important;
    border-left-style: none !important;
    border-radius: 0 4px 4px 0 !important;
    flex-grow: 1 !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-outline-thick {
    opacity: 0 !important;
    display: flex !important;
    position: absolute !important;
    top: 0.25em !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    pointer-events: none !important;
    border-radius: 4px !important;
    transition: opacity 0.2s ease, color 0.2s ease !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-outline-thick .mat-form-field-outline-start,
  .mat-form-field-appearance-outline .mat-form-field-outline-thick .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline .mat-form-field-outline-thick .mat-form-field-outline-end {
    border-width: 2px !important;
  }

  /* Hover State (unfocused, non-invalid): outline darkens and does not disappear */
  .mat-form-field-appearance-outline:not(.mat-form-field-disabled):not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-flex:hover .mat-form-field-outline-thick,
  .mat-form-field-appearance-outline:not(.mat-form-field-disabled):not(.mat-focused):not(.mat-form-field-invalid):hover .mat-form-field-outline-thick {
    opacity: 1 !important;
    color: #3f4b57 !important;
  }
  .mat-form-field-appearance-outline:not(.mat-form-field-disabled):not(.mat-focused):not(.mat-form-field-invalid) .mat-form-field-flex:hover .mat-form-field-outline:not(.mat-form-field-outline-thick),
  .mat-form-field-appearance-outline:not(.mat-form-field-disabled):not(.mat-focused):not(.mat-form-field-invalid):hover .mat-form-field-outline:not(.mat-form-field-outline-thick) {
    opacity: 0 !important;
  }

  /* Focused State: Green outline */
  .mat-form-field-appearance-outline.mat-focused:not(.mat-form-field-invalid) .mat-form-field-outline {
    opacity: 0 !important;
  }
  .mat-form-field-appearance-outline.mat-focused:not(.mat-form-field-invalid) .mat-form-field-outline-thick {
    opacity: 1 !important;
    color: #1bb55e !important;
  }
  .mat-form-field-appearance-outline.mat-focused:not(.mat-form-field-invalid) .mat-form-field-outline-thick .mat-form-field-outline-gap {
    border-top-color: transparent !important;
  }

  /* Invalid State: Red outline */
  .mat-form-field-appearance-outline.mat-form-field-invalid .mat-form-field-outline {
    opacity: 0 !important;
  }
  .mat-form-field-appearance-outline.mat-form-field-invalid .mat-form-field-outline-thick {
    opacity: 1 !important;
    color: #dc3545 !important;
  }

  /* Gap Open/Close Behavior */
  /* When focused or floated: gap is transparent */
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-outline-thick .mat-form-field-outline-gap,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-outline-thick .mat-form-field-outline-gap {
    border-top-color: transparent !important;
  }
  /* When invalid but NOT focused and empty: notch gap is CLOSED (solid red border across top) */
  .mat-form-field-appearance-outline.mat-form-field-invalid.mat-form-field-empty:not(.mat-focused) .mat-form-field-outline-thick .mat-form-field-outline-gap {
    border-top-color: currentColor !important;
  }

  /* Labels */
  .mat-form-field-appearance-outline .mat-form-field-label-wrapper {
    position: absolute !important;
    left: 0 !important;
    box-sizing: content-box !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    pointer-events: none !important;
    top: -0.84375em !important;
    padding-top: 0.84375em !important;
  }
  .mat-form-field-appearance-outline .mat-form-field-label {
    top: 1.84375em !important;
    margin-top: -0.25em !important;
    left: 0 !important;
    position: absolute !important;
    font-family: 'Montserrat', sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    color: rgba(0, 0, 0, 0.87) !important;
    pointer-events: none !important;
    transform-origin: 0 0 !important;
    transition: transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1), color 0.25s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    display: inline-block !important;
    width: auto !important;
    padding: 0 4px !important;
  }

  /* Resting Label (when empty and unfocused) */
  .mat-form-field-appearance-outline.mat-form-field-empty:not(.mat-focused):not(.mat-form-field-should-float) .mat-form-field-label {
    transform: none !important;
    background-color: transparent !important;
  }
  /* Unfocused Invalid Resting Label: Red inside box */
  .mat-form-field-appearance-outline.mat-form-field-invalid.mat-form-field-empty:not(.mat-focused):not(.mat-form-field-should-float) .mat-form-field-label {
    color: #dc3545 !important;
  }

  /* Floating Label: Floated Up */
  .mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-label,
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-label {
    transform: translateY(-1.42em) scale(0.75) !important;
    width: auto !important;
    background-color: transparent !important;
    font-weight: 600 !important;
    z-index: 2 !important;
  }

  /* Label Colors */
  /* Focused: Green even if invalid (matches official portal) */
  .mat-form-field-appearance-outline.mat-focused .mat-form-field-label,
  .mat-form-field-appearance-outline.mat-focused.mat-form-field-invalid .mat-form-field-label {
    color: #1bb55e !important;
