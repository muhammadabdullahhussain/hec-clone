.km-rating {
  list-style: none;
  padding: 0;
  margin: 0 0 0 auto;
  display: -ms-flexbox;
  display: flex;
}
.km-rating li {
  position: relative;
  margin: 0 10px 0 0;
  font-size: 22px;
}
.km-rating li input {
  position: absolute;
  opacity: 0;
  cursor: pointer;
  height: 0;
  width: 0;
}
.km-rating li i {
  color: #666666;
  transition-duration: 0.25s;
  font-weight: bolder;
}
.km-rating li strong {
  position: absolute;
  top: -11px;
  right: auto;
  bottom: auto;
  left: -3px;
  opacity: 0;
  font-size: 10px;
  min-width: 60px;
  color: #333333;
  font-weight: 600;
  transition-duration: 0.25s;
}
.km-rating li:hover i {
  color: #000000;
  cursor: pointer;
}
.km-rating li:hover strong {
  opacity: 1;
}
.km-rating li:last-child {
  margin: 0;
}
.km-rating li:first-child strong {
  left: -1px;
}
.km-rating li:first-child:hover strong {
  color: red;
}
.km-rating li:first-child:hover input ~ label i {
  color: red;
}
.km-rating li:first-child input:checked ~ label i {
  color: red;
}
.km-rating li:nth-child(2) strong {
  left: 0;
}
.km-rating li:nth-child(2):hover strong {
  color: #f44336;
}
.km-rating li:nth-child(2):hover input ~ label i {
  color: #f44336;
}
.km-rating li:nth-child(2) input:checked ~ label i {
  color: #f44336;
}
.km-rating li:nth-child(3):hover strong {
  color: #ff9800;
}
.km-rating li:nth-child(3):hover input ~ label i {
  color: #ff9800;
}
.km-rating li:nth-child(3) input:checked ~ label i {
  color: #ff9800;
}
.km-rating li:nth-child(4) strong {
  left: -15px;
}
.km-rating li:nth-child(4):hover strong {
  color: #55b309;
}
.km-rating li:nth-child(4):hover input ~ label i {
  color: #55b309;
}
.km-rating li:nth-child(4) input:checked ~ label i {
  color: #55b309;
}
.km-rating li:nth-child(5) strong {
  left: -11px;
}
.km-rating li:nth-child(5):hover strong {
  color: #048753;
}
.km-rating li:nth-child(5):hover input ~ label i {
  color: #048753;
}
.km-rating li:nth-child(5) input:checked ~ label i {
  color: #048753;
}
