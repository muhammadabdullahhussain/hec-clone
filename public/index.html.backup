.selection-card {
  display: inline-block;
  min-height: 117px;
  vertical-align: middle;
  margin-right: 10px;
  min-width: 181.65px;
  text-align: center;
  border: 1px solid rgba(193, 193, 193, 0.22);
  border-radius: 5px;
  background: #ffffff;
  position: relative;
  line-height: 81px;
}
@media (max-width: 1024px) {
  .selection-card {
    min-width: 150px;
  }
}
.selection-card:hover {
  box-shadow: 3px 6px 15px 0px rgba(0, 0, 0, 0.06);
  background: linear-gradient(to bottom, rgba(0, 181, 94, 0.1), rgba(0, 181, 94, 0));
}
.selection-card.selected-card {
  background: linear-gradient(to bottom, rgba(0, 181, 94, 0.1), rgba(0, 181, 94, 0));
  border: 1px solid #1bb55e;
}
.selection-card .hover-content {
  background: rgba(0, 0, 0, 0.69);
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 5px;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-pack: center;
      justify-content: center;
  -ms-flex-align: center;
      align-items: center;
  -ms-flex-direction: column;
      flex-direction: column;
}
